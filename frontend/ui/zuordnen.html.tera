{% extends "ui/index" %}

{% block question_type %}
Zuordnungsfrage
{% endblock question_type %}

{% block answers %}
<script type="text/javascript" src="ui/zuordnen.js"></script>

<button id="buttonA" class="answerButton toggleAnswerButton" onclick="toggleAnswer(0)">
  A: {{ answers[0] }}
</button><br>
<button id="buttonB" class="answerButton toggleAnswerButton" onclick="toggleAnswer(1)">
  B: {{ answers[1] }}
</button><br>
<button id="buttonC" class="answerButton toggleAnswerButton" onclick="toggleAnswer(2)">
  C: {{ answers[2] }}
</button><br>
<button id="buttonD" class="answerButton toggleAnswerButton" onclick="toggleAnswer(3)">
  D: {{ answers[3] }}
</button><br>
<button id="buttonE" class="answerButton toggleAnswerButton" onclick="toggleAnswer(4)">
  E: {{ answers[4] }}
</button><br>
<button id="buttonF" class="answerButton toggleAnswerButton" onclick="toggleAnswer(5)">
  F: {{ answers[5] }}
</button><br>

<div id="currentAnswer" class="largeText"></div>
{% endblock answers %}

{% block solution %}
{{ solution_letters }}
{% endblock solution %}

{% block extra_buttons %}
<button id="buttonClear" class="extraButton" onclick="clearAnswerSelection()">
  Auswahl löschen
</button>
{% endblock extra_buttons %}
